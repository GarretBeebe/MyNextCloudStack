# Nextcloud admin account
NEXTCLOUD_ADMIN_USER=ncadmin
ADMIN_PASSWORD=

# Redis password (used by both the redis service and nextcloud app)
REDIS_PASSWORD=

# PostgreSQL config
POSTGRES_DB=nextclouddb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Host paths for persistent data volumes
HOST_POSTGRES_DATA_DIR=/path/to/postgres/data
HOST_NEXTCLOUD_DATA_DIR=/path/to/nextcloud/data
HOST_PHP_INI_PATH=/path/to/NextCloud/php/zzz-opcache-tuning.ini

# Local network
DNS_SERVER=192.168.X.X

# SMTP / email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTHTYPE=LOGIN
SMTP_NAME=user@gmail.com
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=user        # local part only, no @domain
MAIL_DOMAIN=gmail.com
